<AnchorPane prefHeight="636.0" prefWidth="506.0" style="-fx-background-color: #BAE6FD;" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.braynsystem.analisissemantico.TablaSimbolos.TablaSController">
   <children>
      <Label layoutX="102.0" layoutY="14.0" text="Tabla de simbolos y direcciones ">
         <font>
            <Font name="System Bold Italic" size="20.0" />
         </font>
      </Label>
      <Label layoutX="210.0" layoutY="70.0" text="Codigo a analizar:" />
      <TextArea fx:id="txaCodigo" layoutX="101.0" layoutY="102.0" prefHeight="99.0" prefWidth="302.0" />
      <Button fx:id="btnIniciar" layoutX="158.0" layoutY="213.0" mnemonicParsing="false" onAction="#onIniciar" style="-fx-background-color: #D1FAE5;" text="Generar" />
      <Button fx:id="btnLimpiar" layoutX="304.0" layoutY="213.0" mnemonicParsing="false" onAction="#onLimpiar" style="-fx-background-color: #D1FAE5;" text="Limpiar" />
      <TableView fx:id="tablaSimbolos" layoutX="101.0" layoutY="264.0" prefHeight="200.0" prefWidth="302.0">
